pipeline {
    agent any 

    tools {
        nodejs 'nodejs'
    }

    environment  {
        SCANNER_HOME = tool 'sonar-scanner'
        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_ECR_REPO_NAME = "frontend"
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    credentialsId: 'GITHUB-APP',
                    url: 'https://github.com/SathwickDutt/MERN-EKS-DevSecOps-Forge.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Application-Code/frontend') {
                    withSonarQubeEnv('sonar-server') {
                        sh """
                        ${SCANNER_HOME}/bin/sonar-scanner \
                        -Dsonar.projectName=frontend \
                        -Dsonar.projectKey=frontend
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('Application-Code/frontend') {
                    sh "trivy fs . > trivyfs.txt"
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Application-Code/frontend') {
                    sh "docker system prune -f"
                    sh "docker build -t ${AWS_ECR_REPO_NAME} ."
                }
            }
        }

        stage('Login to ECR') {
            steps {
                sh """
                aws ecr get-login-password --region ${AWS_DEFAULT_REGION} \
                | docker login --username AWS --password-stdin ${REPOSITORY_URI}
                """
            }
        }

        stage('Tag & Push Image') {
            steps {
                sh """
                docker tag ${AWS_ECR_REPO_NAME} ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}
                docker push ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}
                """
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh "trivy image ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER} > trivyimage.txt"
            }
        }

        stage('Update Kubernetes Manifest') {
            environment {
                GIT_REPO_NAME = "MERN-EKS-DevSecOps-Forge"
                GIT_USER_NAME = "SathwickDutt"
            }
            steps {
                dir('Kubernetes-Manifests-file/Frontend') {
                    withCredentials([string(credentialsId: 'GITHUB-APP', variable: 'GITHUB_TOKEN')]) {
                        sh """
                        git config user.email "korrapatisathwickdutt@gmail.com"
                        git config user.name "SathwickDutt"

                        CURRENT_TAG=\$(grep -oP '(?<=frontend:)[^ ]+' deployment.yaml)

                        sed -i "s/${AWS_ECR_REPO_NAME}:\${CURRENT_TAG}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}/" deployment.yaml

                        git add deployment.yaml
                        git commit -m "Update frontend image to ${BUILD_NUMBER}" || echo "No changes to commit"
                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
